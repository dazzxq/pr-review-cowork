# ─── PR Review Agent — Cowork-Lite Config ──────────────────────────────────
# Copy file này thành `.env` rồi điền creds.
#   cp .env.example .env
# `.env` đã được gitignore — KHÔNG commit secrets vào repo.

# ── Gmail credentials (BẮT BUỘC) ───────────────────────────────────────────
# Dùng cho:
#   1. IMAP fetch HTML body của email (workaround Anthropic Gmail connector
#      limitation — connector không trả HTML body cho mail HTML-only)
#   2. SMTP send draft (chỉ khi SEND_MODE=true)
#
# Cùng 1 app password dùng cho cả 2. Tạo tại:
#   https://myaccount.google.com/apppasswords
# Yêu cầu account đã bật 2-Step Verification. Nếu là Workspace, admin có thể
# đã tắt App Password — liên hệ IT.
GMAIL_EMAIL=
GMAIL_APP_PASSWORD=

# ── Mode: gửi mail thẳng hay chỉ tạo draft? ─────────────────────────────────
# false  = chỉ tạo Gmail Draft (mặc định, an toàn — bạn approve thủ công)
# true   = gửi luôn qua SMTP (yêu cầu GMAIL_* ở trên)
#
# Nếu set true mà credentials thiếu/sai → agent sẽ log error rồi FALLBACK
# về draft mode để không bỏ sót mail.
SEND_MODE=false

# ── IMAP server (mặc định OK cho Gmail/Workspace) ──────────────────────────
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ── SMTP server (mặc định OK cho Gmail/Workspace) ──────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465

# ── Senior reviewers (skip-list) ───────────────────────────────────────────
# Agent skip thread nếu BẤT KỲ message nào trong thread có `from` chứa 1 trong
# các email dưới — vì sếp duyệt thủ công thì agent không nên tạo draft trùng.
#
# Format: comma-separated, lowercase, không dấu cách quanh dấu phẩy.
# BẮT BUỘC set theo team của bạn — đổi placeholder bên dưới sang email thật.
# Bỏ trống / xoá dòng này → script log warning + agent KHÔNG skip ai cả.
REVIEWER_EMAILS=senior1@example.com,senior2@example.com

# ── Backward-compat (legacy SENDER_*) ──────────────────────────────────────
# scripts đọc cả 2 prefix: ưu tiên GMAIL_*, fallback SENDER_*. User cũ với
# .env có SENDER_EMAIL/SENDER_APP_PASSWORD vẫn work — không cần migrate.
# Khuyến nghị dùng GMAIL_* cho repo mới (rõ nghĩa hơn vì giờ dùng cho IMAP).
